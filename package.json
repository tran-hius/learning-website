{
  "name": "learning-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @learning/web dev",
    "dev:api": "pnpm --filter @learning/api dev",
    "build": "pnpm --filter @learning/api build && pnpm --filter @learning/web build",
    "build:api": "pnpm --filter @learning/api build",
    "build:web": "pnpm --filter @learning/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @learning/api test",
    "prisma:generate": "pnpm --filter @learning/api prisma:generate",
    "prisma:validate": "pnpm --filter @learning/api prisma:validate"
  }
}
