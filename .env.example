# ── SynapseBrain — env mẫu ──────────────────────────────────────────────
# Copy → .env (root, cho apps/api). D13: demo mode chạy được KHÔNG cần điền
# giá trị thật — thiếu env thì code vẫn build/chạy ở development (default dev).
# Production: DATABASE_URL / REDIS_URL / AUTH_SECRET BẮT BUỘC (không default),
# AUTH_SECRET không được còn giá trị dev.

# Node environment: development | test | production
NODE_ENV=development

# API
PORT=4000
# URL gốc của API (dùng dựng OAuth redirect URI)
API_BASE_URL=http://localhost:4000
# Origin của web được phép gọi API (CORS)
CORS_ORIGIN=http://localhost:3000

# ── Database (TiDB Cloud Serverless / MySQL) ────────────────────────────
# TiDB: mysql://<user>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<db>?ssl_accept=accept_invalid_cert
DATABASE_URL=mysql://dev:dev@localhost:3306/scaffold_dev

# ── Redis (Upstash) — cache/rate limit/exam session mirror ─────────────
# Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ──────────────────────────────────────────────────────────
# Tối thiểu 16 ký tự; production phải thay giá trị dev.
AUTH_SECRET=dev-only-secret-key-please-rotate

# ── Cloudinary (upload avatar/media) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── OAuth (link-by-email MVP — để trống nếu chưa cấu hình) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Piston (chạy code Python, P3) ──────────────────────────────────────
# Mặc định public emkc.org; khi deploy nên self-host (xem README) rồi trỏ URL.
PISTON_URL=https://emkc.org/api/v2/piston/execute
